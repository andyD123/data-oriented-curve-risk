{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (AVX2 and AVX-512 targets)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LADDER_LANES": "AVX2",
        "LADDER_DUAL_ISA": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "release-avx512",
      "displayName": "Release (AVX512)",
      "binaryDir": "${sourceDir}/build/release-avx512",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LADDER_LANES": "AVX512",
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "release-avx2",
      "displayName": "Release (AVX2)",
      "binaryDir": "${sourceDir}/build/release-avx2",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LADDER_LANES": "AVX2",
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "release-portable",
      "displayName": "Release (PORTABLE)",
      "binaryDir": "${sourceDir}/build/release-portable",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LADDER_LANES": "PORTABLE",
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "release-paper",
      "inherits": "release-avx512",
      "displayName": "Release (AVX-512 paper benchmarks)",
      "binaryDir": "${sourceDir}/build/release-paper",
      "cacheVariables": {
        "LADDER_BUILD_PAPER_BENCHMARKS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "release-avx512",
      "configurePreset": "release-avx512",
      "configuration": "Release"
    },
    {
      "name": "release-avx2",
      "configurePreset": "release-avx2",
      "configuration": "Release"
    },
    {
      "name": "release-portable",
      "configurePreset": "release-portable",
      "configuration": "Release"
    },
    {
      "name": "release-paper",
      "configurePreset": "release-paper",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Release"
    },
    {
      "name": "release-avx512",
      "configurePreset": "release-avx512",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Release"
    },
    {
      "name": "release-avx2",
      "configurePreset": "release-avx2",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Release"
    },
    {
      "name": "release-portable",
      "configurePreset": "release-portable",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Release"
    },
    {
      "name": "release-paper",
      "configurePreset": "release-paper",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Release"
    }
  ]
}
